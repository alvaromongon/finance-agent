# Finance Agent engine — environment variables. Copy to .env and fill in.
# Never commit real values: in CI they come from repository vars and secrets.
# Every variable the engine reads is listed here. "Required" ones have no
# default in the code; the rest show their default.

# --- Data (required) ---
# Directory with the data files the engine reads and writes (portfolio.md,
# watchlist.md, screening-universe.md, theses, logs). See docs/input-format.md.
VAULT_PROJECT_DIR=
# Archived quarters of logs/decisions.jsonl (decisions-YYYY-QN.jsonl).
# Must be an absolute path (it is not resolved against VAULT_PROJECT_DIR).
# Empty = no archive: only the live log is read. Needed only for the full history in
# decisions:evaluate and decisions:chart; decision:record records correctly without it.
# The engine warns on stderr when it is unset (one line per run), missing, not a directory or
# not absolute. See docs/log-retention.md.
DECISIONS_ARCHIVE_DIR=

# --- Silo reference ETFs (required) ---
# Accumulating ETF per silo: shadow portfolio, market regime and relative
# strength. Yahoo Finance symbols, e.g. EXSA.DE (STOXX Europe 600) or VOO (S&P 500).
REFERENCE_TICKER_EUR=
REFERENCE_TICKER_USD=

# --- Market data ---
MARKET_DATA_PROVIDER=yahoo-finance   # yahoo-finance | fixtures (saved bars, no network)
MARKET_FIXTURES_DIR=                 # fixtures only: directory with one <TICKER>.json per ticker, e.g. examples/market
PORTFOLIO_STALE_DAYS=7               # days without updating portfolio.md before warning
MARKET_SESSION_MAX_AGE_HOURS=        # empty = engine default; age of the last tick to treat the session as current

# --- Analyst (escalation to Claude) ---
ANALYST_PROVIDER=api                 # api (Anthropic API, paid) | handoff (writes logs/pending/ for a Claude Code routine)
ANTHROPIC_API_KEY=                   # only with ANALYST_PROVIDER=api and for the API mode of briefing/screening
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_EFFORT=high                   # low | medium | high | max
ANALYST_WEB_SEARCH=true              # web search for the big_move trigger
CLAUDE_WEEKLY_MODEL=claude-opus-4-8     # model of the weekly runs in API mode
CLAUDE_WEEKLY_EFFORT=medium            # effort of the weekly runs in API mode

# --- Email ---
# Locally, without SMTP_USER, SMTP_PASS or ALERT_EMAIL_TO no email is sent: the body is
# printed to the log ("logs only" mode). The reusable workflows set
# MAIL_REQUIRE_DELIVERY=true, so there a run without SMTP fails unless email is off.
MAIL_TRANSPORT=smtp                  # smtp | outbox (queues in logs/outbox/ for a relay to send) | none (email off: nothing is sent, the run passes)
MAIL_REQUIRE_DELIVERY=false          # true = an email that cannot be delivered fails the run (ignored with none)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=                           # for Gmail, an app password (requires 2FA)
ALERT_EMAIL_TO=                      # recipient of alerts and reports
ALERT_EMAIL_FROM=                    # sender; empty = SMTP_USER

# --- Output language ---
# Emails, reports and notes the engine writes. What it reads back is not localized.
OUTPUT_LANGUAGE=en                   # en | es

# --- Strategy thresholds ---
STOP_PROXIMITY_PCT=3                 # % distance to the stop that escalates
STOP_MIN_ATR=                        # empty = engine default; minimum stop distance in ATR14 before warning
BIG_MOVE_PCT=5                       # daily move (%) that fires big_move
REANALYSIS_PRICE_DELTA_PCT=3         # price change (%) that skips the re-analysis cooldown

# --- Broker ---
# The engine integrates with no broker: the portfolio is synced by hand.
BROKER_FRACTIONAL_SHARES=true        # true = fractional units; false = whole shares
BROKER_MIN_ORDER_VALUE=10            # minimum order amount with fractional shares, in the silo currency
BROKER_FX_CONVERSION_PCT=0.5         # default fee when converting between currencies (%)
